# ---- Required for production ----
# Public URL of the site (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://biodatakaro.com

# Razorpay API keys (Dashboard → Account & Settings → API Keys). rzp_test_… for testing, rzp_live_… for real money.
# If both are empty the app runs in clearly-labelled MOCK payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Random 32+ char secret used to sign unlock tokens (stateless, no DB). Generate: openssl rand -hex 32
# Falls back to RAZORPAY_KEY_SECRET if empty. Changing it invalidates previously issued unlocks.
UNLOCK_TOKEN_SECRET=

# ---- Recommended ----
# Razorpay webhook secret (Dashboard → Webhooks). Endpoint: https://YOUR_DOMAIN/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional: AI writing (without these the built-in template writer is used) ----
# Gemini is tried first, then OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_RATE_LIMIT_PER_MIN=6
AI_RATE_LIMIT_PER_DAY=40

# ---- Owner details shown on legal pages (replace the placeholders) ----
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_OWNER_CITY=

# Set to 1 to refuse mock payments when Razorpay keys are missing (safety for production).
PAYMENTS_DISABLE_MOCK=
# Reserved for later; no ad code ships today.
NEXT_PUBLIC_ADSENSE_CLIENT=
